# Copy to .env (gitignored) and fill the secrets.
NODE_ENV="development"

# --- Database: Docker locally (`pnpm db:up`), Supabase in production (transaction pooler URL, port 6543) ---
DATABASE_URL="postgres://anbill:anbill@localhost:5433/anbill"

# --- Model provider: OpenAI (ADR 0002 Q7) ---
OPENAI_API_KEY=""
# mid tier answers the admin — $0.75 / $4.50 per 1M tokens in/out
MODEL_PRIMARY="gpt-5.4-mini"
# next tier down for rate limits/outages — $0.20 / $1.25
MODEL_FALLBACK="gpt-5.4-nano"
# smallest tier for recap and trash talk — $0.05 / $0.40
MODEL_CHEAP="gpt-5-nano"
# Cost line: ≈ $0.89/month at ~10 admin turns/day × 22 days (3k in / 400 out tokens per turn); budget ~2 USD

# --- Admin: the only account. Viewers never log in. ---
ADMIN_PASSWORD=""
# HMAC key for the admin cookie (>= 32 chars): openssl rand -hex 32
SESSION_SECRET=""

# --- Google sign-in for members (both empty hides the button) ---
# Google Cloud Console → OAuth client (Web); redirect URI <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google emails that are also admin on sign-in
ADMIN_EMAILS=""

APP_TIMEZONE="Asia/Ho_Chi_Minh"

# --- Tracing: none | langsmith (masking always on) ---
TRACING_PROVIDER="langsmith"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="billiards-board"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_AGENT_ID="billiards-board"
# local | production — a trace filter in LangSmith
LANGSMITH_AGENT_ENVIRONMENT="local"
# HMAC key so the admin id reaches traces only as a hash (>= 16 chars): openssl rand -hex 16
TRACE_HASH_KEY=""
# Must stay "false": "true" turns on LangChain's global auto-tracer, which sends unmasked prompts.
LANGSMITH_TRACING="false"

# CopilotKit runtime telemetry off
COPILOTKIT_TELEMETRY_DISABLED="true"

# --- PII: input redaction of email, credit card, IP (regex, no model call) ---
PII_REDACTION="on"
